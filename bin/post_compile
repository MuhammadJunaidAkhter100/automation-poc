#!/usr/bin/env bash
# Install Playwright system libraries on Heroku.
echo "-----> post_compile: Installing Playwright system dependencies..."

if command -v apt-get &> /dev/null; then
    apt-get update -qq 2>&1 | tail -3
    apt-get install -y \
      libatk-1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libpango-1.0-0 libcairo2 libasound2 \
      2>&1 | tail -10
    echo "-----> post_compile: apt-get exit code: $?"
fi

# Fallback: use Playwright's own dependency installer
python -m playwright install-deps chromium 2>&1 | tail -10 || echo "-----> post_compile: playwright install-deps not available"

echo "-----> post_compile: done"
