#!/usr/bin/env bash
# Bundle Playwright system libraries inside /app so they persist in the slug.
echo "-----> post_compile: Bundling Playwright system libraries into /app..."

command -v apt-get &>/dev/null || { echo "-----> post_compile: apt-get not available, skipping"; exit 0; }

apt-get update -qq 2>&1 | tail -2 || true

PKGS="libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3
      libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2
      libgbm1 libpango-1.0-0 libcairo2 libasound2"

for pkg in $PKGS; do
    echo "       Downloading $pkg..."
    apt-get download "$pkg" 2>/dev/null || true
done

for deb in *.deb; do
    [ -f "$deb" ] || continue
    echo "       Extracting $deb..."
    dpkg -x "$deb" /app/ 2>/dev/null || true
    rm -f "$deb"
done

echo "-----> post_compile: Libraries bundled."
